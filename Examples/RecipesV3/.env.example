# Copy to .env (gitignored) or reuse private credentials:
#   /Users/laptop/Sync/private/credentials/swift-instant-data/recipes-v3.env
#
# Provision with:
#   Examples/RecipesV3/provision-live-app.sh
#   # or --fresh for a new getadb.com app
#
# Only INSTANT_APP_ID is required for the Mac/iOS recipes hosts.
# INSTANT_ADMIN_TOKEN is for schema/perms push and admin tooling — never ship it
# inside application bundles.

INSTANT_APP_ID=
# INSTANT_ADMIN_TOKEN=
