{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "noImplicitAny": false,
    "strict": true,
    "target": "ES2022",
    "paths": {
      "@instantdb/core": ["node_modules/@instantdb/core"]
    }
  },
  "include": [
    ".generated-contract.*/*.ts",
    "../fixtures/recording-action.server.schema.ts",
    "../fixtures/sharing.schema.ts",
    "src/recording-action-sdk-contract.ts",
    "src/recording-action-sdk-contract.test.ts",
    "src/auth-live-contract.ts",
    "src/sharing-sdk-contract.ts",
    "src/sharing-sdk-contract.test.ts",
    "src/sharing-runtime-schema.ts",
    "src/sharing-live-contract.ts"
  ]
}
