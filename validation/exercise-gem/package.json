{
  "name": "instant-exercise-gem",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "InstantDB TypeScript vs Swift correctness + throughput exercise gem (#156 expansion)",
  "scripts": {
    "gem": "tsx src/run.ts",
    "gem:simple": "tsx src/run.ts --suite simple",
    "gem:complex": "tsx src/run.ts --suite complex",
    "gem:speed": "tsx src/run.ts --suite speed",
    "gem:memory": "tsx src/run.ts --suite memory-cap",
    "gem:bandwidth": "tsx src/run.ts --suite bandwidth-cap",
    "gem:cpu": "tsx src/run.ts --suite cpu-cap",
    "gem:all": "tsx src/run.ts --suite all",
    "gem:analyze": "tsx src/run.ts --suite analyze-only",
    "electron": "electron electron/main.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@instantdb/admin": "1.0.49",
    "@instantdb/core": "1.0.49"
  },
  "devDependencies": {
    "@types/node": "22.13.0",
    "@types/ws": "8.5.13",
    "electron": "35.1.2",
    "tsx": "4.19.3",
    "typescript": "5.9.3",
    "ws": "8.18.0"
  }
}
